    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: MyMemory Proxy",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["proxy:app", "--port", "8096", "--reload"],
            "cwd": "${workspaceFolder}"
        }
    ]
}